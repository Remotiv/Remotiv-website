# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit actual secrets.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL (e.g. https://<ref>.supabase.co). Safe to expose to the client.
NEXT_PUBLIC_SUPABASE_URL=

# Anonymous public key. Safe to expose to the client; RLS enforces auth.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER-ONLY — never prefix with NEXT_PUBLIC_.
# Bypasses RLS. Used by server actions / API routes only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (transactional email) ─────────────────────────────────────────────
# API key from https://resend.com/api-keys. Leave blank in dev to skip sending.
RESEND_API_KEY=

# Verified sender — must match a domain configured in Resend.
RESEND_FROM_EMAIL=noreply@remotiv.work

# Internal recipient for team alerts (new hire requests, etc.).
RESEND_TEAM_EMAIL=waleed.nazim@remotiv.work

# ── Site URL ─────────────────────────────────────────────────────────────────
# Public origin used in email CTAs to build absolute links into the admin.
NEXT_PUBLIC_SITE_URL=https://remotiv-website-m3jo.vercel.app

# Anthropic Claude API key for AI Matching (Haiku model). Get from console.anthropic.com
ANTHROPIC_API_KEY=

# ── Upstash Redis ────────────────────────────────────────────────────────────
# Upstash Redis — required for cross-instance rate limiting
# Get values from https://console.upstash.com/redis (REST API tab)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here
